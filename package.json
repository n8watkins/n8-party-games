{
  "name": "n8-party-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The party kit and the party site: party games that share one room kit. Live on Cloudflare Workers at partygames.n8builds.dev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8watkins/n8-party-games.git"
  },
  "exports": {
    "./kit": "./party-kit/src/worker/index.js",
    "./kit/core": "./party-kit/src/core/room-core.js",
    "./kit/rng": "./party-kit/src/core/rng.js",
    "./kit/http": "./party-kit/src/worker/http.js",
    "./kit/build": "./party-kit/build/public.mjs",
    "./kit/client/*": "./party-kit/client/*",
    "./package.json": "./package.json"
  },
  "files": [
    "party-kit/src",
    "party-kit/client",
    "party-kit/build",
    "party-kit/test/e2e-*.mjs",
    "party-kit/README.md",
    "party-kit/GAME-CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wrangler dev --local --env local --port 8791",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "node scripts/build-public.mjs",
    "assets:list": "node scripts/build-public.mjs --list",
    "deploy": "wrangler deploy --env=''",
    "test": "vitest run",
    "playtest": "node node_modules/cork-and-bell/tools/playtest.mjs",
    "playtest:battle": "node node_modules/cork-and-bell/tools/playtest-battle.mjs",
    "test:room": "node party-kit/test/e2e-room.mjs",
    "test:lobby": "node lobby/test/e2e-lobby.mjs",
    "test:cork": "node lobby/test/e2e-cork.mjs",
    "test:feel": "node lobby/test/e2e-feel.mjs",
    "test:frames": "node lobby/test/e2e-frames.mjs",
    "lobby:shots": "node lobby/test/shoot.mjs",
    "lobby:measure": "node lobby/test/measure.mjs",
    "test:cork:3d": "node lobby/test/e2e-cork-3d.mjs",
    "lobby:shots:3d": "node lobby/test/shoot-3d.mjs",
    "lobby:shots:bump": "node lobby/test/shoot-bump.mjs",
    "lobby:stills:3d": "node lobby/test/shoot-3d-stills.mjs",
    "lobby:measure:3d": "node lobby/test/measure-3d.mjs",
    "test:production": "node party-kit/test/e2e-production.mjs",
    "test:turnstile": "node party-kit/test/e2e-turnstile.mjs"
  },
  "dependencies": {
    "lean-qr": "^2.7.4"
  },
  "devDependencies": {
    "cork-and-bell": "github:n8watkins/cork-and-bell#adb6e7b20fd5bb7a2ac45de045bfea839e5946fe",
    "playwright": "^1.64.1",
    "vitest": "4.1",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
