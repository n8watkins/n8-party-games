{
  "name": "n8-party-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The party kit and the party site: party games that share one room kit. Live on Cloudflare Workers at partygames.n8builds.dev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8watkins/n8-party-games.git"
  },
  "exports": {
    "./kit": "./party-kit/src/worker/index.js",
    "./kit/core": "./party-kit/src/core/room-core.js",
    "./kit/rng": "./party-kit/src/core/rng.js",
    "./kit/http": "./party-kit/src/worker/http.js",
    "./kit/build": "./party-kit/build/public.mjs",
    "./kit/build/folders": "./party-kit/build/folders.mjs",
    "./kit/client/*": "./party-kit/client/*",
    "./lobby/core": "./lobby/server/lobby-core.js",
    "./lobby/vote": "./lobby/shared/vote.js",
    "./lobby/wall": "./lobby/wall.js",
    "./lobby/world": "./lobby/shared/world.js",
    "./testing/browser": "./lobby/test/browser.mjs",
    "./testing/client": "./lobby/test/client.mjs",
    "./testing/stills": "./party-kit/test/stills.mjs",
    "./package.json": "./package.json"
  },
  "workspaces": [
    "games/*"
  ],
  "files": [
    "party-kit/src",
    "party-kit/client",
    "party-kit/build",
    "party-kit/test/e2e-*.mjs",
    "party-kit/README.md",
    "party-kit/GAME-CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wrangler dev --local --env local --port 8791",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "node scripts/build-public.mjs",
    "assets:list": "node scripts/build-public.mjs --list",
    "deploy": "wrangler deploy --env=''",
    "test": "vitest run",
    "predeploy": "node .github/scripts/predeploy.mjs --deploy",
    "gate": "node .github/scripts/predeploy.mjs",
    "playtest": "node node_modules/cork-and-bell/tools/playtest.mjs",
    "playtest:battle": "node node_modules/cork-and-bell/tools/playtest-battle.mjs",
    "test:room": "node party-kit/test/e2e-room.mjs",
    "test:lobby": "node lobby/test/e2e-lobby.mjs",
    "test:lobby:full": "node lobby/test/e2e-lobby.mjs --full=1",
    "test:cork": "node lobby/test/e2e-cork.mjs",
    "test:cork:full": "node lobby/test/e2e-cork.mjs --apart=1",
    "test:feel": "node lobby/test/e2e-feel.mjs",
    "test:characters": "node lobby/test/e2e-characters.mjs",
    "test:ghost": "node lobby/test/e2e-ghost.mjs",
    "test:moves": "node lobby/test/e2e-moves.mjs",
    "test:counters": "node lobby/test/e2e-counters.mjs",
    "test:emotes": "node lobby/test/e2e-emotes.mjs",
    "test:frames": "node lobby/test/e2e-frames.mjs",
    "test:leave-rooms": "node lobby/test/e2e-leave-rooms.mjs",
    "test:screen": "node lobby/test/e2e-screen.mjs",
    "test:room-pick": "node lobby/test/e2e-room-pick.mjs",
    "test:drop": "node lobby/test/e2e-drop.mjs",
    "test:mode": "node lobby/test/e2e-mode.mjs",
    "test:hot-potato": "node one-device/hot-potato/test/e2e-game.mjs",
    "test:hot-potato:full": "node one-device/hot-potato/test/e2e-game.mjs --lanes=1",
    "test:hearing": "node lab/hot-potato/test/e2e-hearing.mjs",
    "test:two-rooms": "node lobby/test/e2e-two-rooms.mjs",
    "test:paper-masks": "node party/games/paper-masks/test/e2e-paper-masks.mjs",
    "test:paper-masks:full": "node party/games/paper-masks/test/e2e-paper-masks.mjs --together=1",
    "test:who-am-i": "node party/games/who-am-i/test/e2e-who-am-i.mjs",
    "test:table": "node lobby/test/e2e-table.mjs",
    "test:bar-wall": "node lobby/test/e2e-bar-wall.mjs",
    "test:home": "node site/test/e2e-home.mjs",
    "lobby:shots": "node lobby/test/shoot.mjs",
    "lobby:measure": "node lobby/test/measure.mjs",
    "test:cork:3d": "node lobby/test/e2e-cork-3d.mjs",
    "test:cork:switches": "node lobby/test/e2e-cork-switches.mjs",
    "lobby:shots:3d": "node lobby/test/shoot-3d.mjs",
    "lobby:shots:bump": "node lobby/test/shoot-bump.mjs",
    "lobby:stills:3d": "node lobby/test/shoot-3d-stills.mjs",
    "lobby:measure:3d": "node lobby/test/measure-3d.mjs",
    "test:production": "node party-kit/test/e2e-production.mjs",
    "test:turnstile": "node party-kit/test/e2e-turnstile.mjs",
    "test:release": "node lobby/test/e2e-release.mjs",
    "test:tin-derby": "node games/tin-derby/test/e2e-room.mjs --only=short",
    "test:tin-derby:full": "node games/tin-derby/test/e2e-room.mjs --only=solo,two,four,panes,trouble,stalls,noscreen,screens,look,lag,tvlag",
    "release": "release-kit release",
    "release:check": "release-kit check && npm test && npm run build",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "es-module-lexer": "3.0.5",
    "lean-qr": "^2.7.4"
  },
  "devDependencies": {
    "cork-and-bell": "github:n8watkins/cork-and-bell#32a420b8c1538a82e175f8f318389050c38ad387",
    "playwright": "^1.65.1",
    "release-kit": "github:n8watkins/release-kit#v2.10.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "vitest": "5.1",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
