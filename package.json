{
  "name": "n8-party-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Party games that share one room kit. Ready for Cloudflare Workers, not deployed yet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8watkins/n8-party-games.git"
  },
  "exports": {
    "./kit": "./party-kit/src/worker/index.js",
    "./kit/core": "./party-kit/src/core/room-core.js",
    "./kit/rng": "./party-kit/src/core/rng.js",
    "./kit/http": "./party-kit/src/worker/http.js",
    "./kit/build": "./party-kit/build/public.mjs",
    "./kit/client/*": "./party-kit/client/*",
    "./package.json": "./package.json"
  },
  "files": [
    "party-kit/src",
    "party-kit/client",
    "party-kit/build",
    "party-kit/test/e2e-*.mjs",
    "party-kit/README.md",
    "party-kit/GAME-CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wrangler dev --local --env local --port 8791",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "node scripts/build-public.mjs",
    "assets:list": "node scripts/build-public.mjs --list",
    "deploy": "wrangler deploy --env=''",
    "test": "vitest run",
    "playtest": "node cork-and-bell/tools/playtest.mjs",
    "playtest:battle": "node cork-and-bell/tools/playtest-battle.mjs",
    "test:room": "node party-kit/test/e2e-room.mjs",
    "test:production": "node party-kit/test/e2e-production.mjs",
    "test:turnstile": "node party-kit/test/e2e-turnstile.mjs",
    "fps": "node cork-and-bell/tools/gpu-fps.mjs"
  },
  "dependencies": {
    "lean-qr": "^2.7.4"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "three": "^0.186.0",
    "vitest": "4.1",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
