{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is the production Worker: rate limits on, no simulated latency, the 10% room
  // budget. Local play uses the "local" environment (npm run dev). See DEPLOY.md before deploying.
  "name": "n8-party-games",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker.js",
  // Served at https://partygames.n8builds.dev, a Workers custom domain: Cloudflare creates the
  // DNS record and certificate on deploy. The workers.dev address and version preview URLs are
  // off, so all traffic goes through the zone.
  "routes": [{ "pattern": "partygames.n8builds.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // A game's server code may name the kit as a package ("n8-party-games/kit"). Here the kit is
  // this repository's own folder, so the name resolves to it and the bundle holds one copy.
  // The release record (scripts/release.mjs) is written by the build to dist/release.js, beside
  // the public folder's copy the pages import, so the Worker and the pages hold the same record.
  "alias": { "n8-party-games/kit": "./party-kit/src/worker/index.js", "n8-party-games/release": "./dist/release.js" },
  "compatibility_date": "2026-10-01",
  // Only dist/public is served, and it is rebuilt from an allowlist (scripts/build-public.mjs)
  // before every `wrangler dev` and `wrangler deploy`, and on changes while `wrangler dev` runs.
  // `--production` refuses a working tree with uncommitted changes, so what is deployed is one
  // commit; a local server with these settings sets RELEASE_ALLOW_DIRTY=1 (DEPLOY.md, step 3).
  "build": {
    "command": "node scripts/build-public.mjs --production",
    "watch_dir": ["party-kit/client", "party-kit/src", "lobby/public", "lobby/shared", "lobby/server", "lobby/games", "lobby/wall.js", "party/public", "site", "lab", "one-device", "floor", "scripts", "games.js", "worker.js"]
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The Worker version's id, tag and upload time, for /api/version beside the release record.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOMS", "class_name": "PartyRoom" },
      { "name": "PARTY_LOBBIES", "class_name": "LobbyRoom" },
      { "name": "PARTY_PINS", "class_name": "PinDirectory" },
      { "name": "PARTY_LIMITER", "class_name": "RateLimiter" },
      { "name": "PARTY_BUDGET", "class_name": "RoomBudget" },
      { "name": "PARTY_SCORES", "class_name": "ScoreBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom", "PinDirectory", "RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomBudget"] },
    { "tag": "v3", "new_sqlite_classes": ["ScoreBoard"] },
    { "tag": "v4", "new_sqlite_classes": ["LobbyRoom"] }
  ],
  "vars": {
    // The owner's rule for the whole party game system: hosted rooms may use 10% of the Workers
    // Paid plan's included Durable Object time each month (40,000 of 400,000 GB-seconds, about
    // 87 hours of rooms awake), and a tenth of that in any one day. When it is spent, new battles
    // are refused and solo play carries on. All games on this Worker share the one allowance.
    "PARTY_ROOM_BUDGET_SHARE": "0.1",
    "PARTY_RATE_LIMIT": "on",
    "PARTY_SIM_LATENCY": "off",
    // The bot check on new rooms (Cloudflare Turnstile) is off until both keys exist: the site
    // key here (it is public: the widget "Party games new party", Managed, for
    // partygames.n8builds.dev only) and TURNSTILE_SECRET_KEY as a secret. With the site key alone
    // the site behaves as if there were none: /api/party/config hands it out only once the secret
    // is set too. See DEPLOY.md, "The bot check". The local environment has neither.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGM24cDseqMFt3A0"
  },
  "env": {
    // Local play and the test runs: npm run dev, npm run dev:lan. Never deployed.
    "local": {
      // No custom domain: with the top level's route, `wrangler dev` would show the Worker
      // partygames.n8builds.dev as its own address, and this site's local join links (and QR
      // codes) would be refused.
      "routes": [],
      // The local build also holds the pages that are not approved yet (/preview/...): see
      // scripts/build-public.mjs. The production build above never passes --preview.
      "build": {
        "command": "node scripts/build-public.mjs --preview",
        "watch_dir": ["party-kit/client", "party-kit/src", "lobby/public", "lobby/shared", "lobby/server", "lobby/games", "lobby/wall.js", "party/public", "site", "landing/public", "lab", "one-device", "floor", "scripts", "games.js", "worker.js"]
      },
      // Bindings are not inherited, so the version metadata is named again (locally its id is a stand-in).
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "PARTY_ROOMS", "class_name": "PartyRoom" },
          { "name": "PARTY_LOBBIES", "class_name": "LobbyRoom" },
          { "name": "PARTY_PINS", "class_name": "PinDirectory" },
          { "name": "PARTY_LIMITER", "class_name": "RateLimiter" },
          { "name": "PARTY_BUDGET", "class_name": "RoomBudget" },
          { "name": "PARTY_SCORES", "class_name": "ScoreBoard" }
        ]
      },
      "vars": {
        "PARTY_ROOM_BUDGET_SHARE": "0.1",
        // Lets tests ask for simulated latency (?lag=150) and run many headless players.
        "PARTY_SIM_LATENCY": "on",
        "PARTY_RATE_LIMIT": "off",
        // Lets the tests and the cost measurements read the room budget and a room's inner state.
        "PARTY_DEBUG": "on",
        // Hangs Coin Flip, the placeholder game, on the party room's wall. Local play and the
        // test runs only: production has no such variable, so its wall has no test game.
        "PARTY_TEST_GAMES": "on"
      }
    }
  }
}
