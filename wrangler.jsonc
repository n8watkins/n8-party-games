{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development only. Nothing in this repository is deployed.
  "name": "n8-party-games",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOMS", "class_name": "PartyRoom" },
      { "name": "PARTY_PINS", "class_name": "PinDirectory" },
      { "name": "PARTY_LIMITER", "class_name": "RateLimiter" },
      { "name": "PARTY_BUDGET", "class_name": "RoomBudget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom", "PinDirectory", "RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomBudget"] }
  ],
  "vars": {
    // Hosted rooms may use 5% of the Workers Paid plan's included Durable Object time each month
    // (20,000 of 400,000 GB-seconds, about 43 room-hours), and a tenth of that in any one day.
    // When it is spent, new battles are refused and solo play carries on.
    "PARTY_ROOM_BUDGET_SHARE": "0.05",
    // Local play: lets tests ask for simulated latency (?lag=150) and run many headless players.
    "PARTY_SIM_LATENCY": "on",
    "PARTY_RATE_LIMIT": "off"
  }
}
