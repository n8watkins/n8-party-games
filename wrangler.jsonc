{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is the production Worker: rate limits on, no simulated latency, the 10% room
  // budget. Local play uses the "local" environment (npm run dev). See DEPLOY.md before deploying.
  "name": "n8-party-games",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker.js",
  // Served at https://partygames.n8builds.dev, a Workers custom domain: Cloudflare creates the
  // DNS record and certificate on deploy. The workers.dev address and version preview URLs are
  // off, so all traffic goes through the zone.
  "routes": [{ "pattern": "partygames.n8builds.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // A game's server code may name the kit as a package ("n8-party-games/kit"). Here the kit is
  // this repository's own folder, so the name resolves to it and the bundle holds one copy.
  "alias": { "n8-party-games/kit": "./party-kit/src/worker/index.js" },
  "compatibility_date": "2026-10-01",
  // Only dist/public is served, and it is rebuilt from an allowlist (scripts/build-public.mjs)
  // before every `wrangler dev` and `wrangler deploy`, and on changes while `wrangler dev` runs.
  "build": {
    "command": "node scripts/build-public.mjs",
    "watch_dir": ["party-kit/client", "lobby", "site", "scripts", "games.js"]
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOMS", "class_name": "PartyRoom" },
      { "name": "PARTY_LOBBIES", "class_name": "LobbyRoom" },
      { "name": "PARTY_PINS", "class_name": "PinDirectory" },
      { "name": "PARTY_LIMITER", "class_name": "RateLimiter" },
      { "name": "PARTY_BUDGET", "class_name": "RoomBudget" },
      { "name": "PARTY_SCORES", "class_name": "ScoreBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom", "PinDirectory", "RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomBudget"] },
    { "tag": "v3", "new_sqlite_classes": ["ScoreBoard"] },
    { "tag": "v4", "new_sqlite_classes": ["LobbyRoom"] }
  ],
  "vars": {
    // The owner's rule for the whole party game system: hosted rooms may use 10% of the Workers
    // Paid plan's included Durable Object time each month (40,000 of 400,000 GB-seconds, about
    // 87 hours of rooms awake), and a tenth of that in any one day. When it is spent, new battles
    // are refused and solo play carries on. All games on this Worker share the one allowance.
    "PARTY_ROOM_BUDGET_SHARE": "0.1",
    "PARTY_RATE_LIMIT": "on",
    "PARTY_SIM_LATENCY": "off"
    // The bot check on new rooms (Cloudflare Turnstile) is off until both keys exist:
    // TURNSTILE_SITE_KEY here (it is public), TURNSTILE_SECRET_KEY as a secret. See DEPLOY.md.
  },
  "env": {
    // Local play and the test runs: npm run dev, npm run dev:lan. Never deployed.
    "local": {
      // No custom domain: with the top level's route, `wrangler dev` would show the Worker
      // partygames.n8builds.dev as its own address, and this site's local join links (and QR
      // codes) would be refused.
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "PARTY_ROOMS", "class_name": "PartyRoom" },
          { "name": "PARTY_LOBBIES", "class_name": "LobbyRoom" },
          { "name": "PARTY_PINS", "class_name": "PinDirectory" },
          { "name": "PARTY_LIMITER", "class_name": "RateLimiter" },
          { "name": "PARTY_BUDGET", "class_name": "RoomBudget" },
          { "name": "PARTY_SCORES", "class_name": "ScoreBoard" }
        ]
      },
      "vars": {
        "PARTY_ROOM_BUDGET_SHARE": "0.1",
        // Lets tests ask for simulated latency (?lag=150) and run many headless players.
        "PARTY_SIM_LATENCY": "on",
        "PARTY_RATE_LIMIT": "off",
        // Lets the tests and the cost measurements read the room budget and a room's inner state.
        "PARTY_DEBUG": "on"
      }
    }
  }
}
